# AUR-style package that always builds the latest commit from GitHub.
#
# Copy this folder somewhere outside the git checkout first (makepkg updates pkgver in this file):
#   cp -r packaging/arch/aur ~/tm5linux-git && cd ~/tm5linux-git && makepkg -si

pkgname=tm5linux-git
_repo=TM5Linux
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc="RAM stability tester that runs TestMem5 (TM5) configs like Extreme1 by anta777 - GTK4 GUI and CLI"
arch=('x86_64' 'aarch64' 'i686' 'armv7h' 'riscv64')
url="https://github.com/oreo1298/TM5Linux"
license=('MIT')
depends=('glibc' 'python' 'python-gobject' 'gtk4' 'libcap')
makedepends=('git' 'gcc' 'make')
optdepends=('polkit: run tests with administrator rights from the GUI')
provides=('tm5linux')
conflicts=('tm5linux')
install=tm5linux.install
source=("git+https://github.com/oreo1298/TM5Linux.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_repo"
    printf '%s.r%s.g%s' "$(sed -n 's/^VERSION *:= *//p' Makefile)" "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$_repo"
    make PREFIX=/usr
}

check() {
    cd "$_repo"
    ./build/tm5linux-cli --selftest
}

package() {
    cd "$_repo"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    rm -f "$pkgdir/usr/share/tm5linux/uninstall.sh"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
